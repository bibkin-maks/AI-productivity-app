# Copy to backend/.env and fill in.

OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
SECRET_KEY=

# MongoDB connection string, split so the password gets URL-encoded:
# <FIRST><PASS><LAST>, e.g. mongodb+srv://user:  +  p@ss  +  @cluster0.xxxx.mongodb.net/
MONGODB_URI_FIRST=
MONGODB_URI_PASS=
MONGODB_URI_LAST=

# Optional
# CORS_ORIGINS=http://localhost:5173
# PIPER_VOICE=en_GB-jenny_dioco-medium
